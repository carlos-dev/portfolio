# Copie para .env.local e preencha. Necessário só para o formulário de contato.

# Chave da Resend (https://resend.com/api-keys). Free tier: 3k emails/mês.
RESEND_API_KEY=

# Para onde os e-mails do formulário vão. Padrão: profile.email em src/lib/content.ts
CONTACT_TO_EMAIL=

# Remetente. Tem que ser um domínio VERIFICADO na sua conta Resend.
#
# IMPORTANT: endereço de provedor público (@gmail.com, @outlook.com, …) nunca
# funciona — você não tem como verificar um domínio que não é seu. A Resend
# responde 403 "domain is not verified", o envio falha e o formulário cai na
# mensagem de erro genérica, sem dizer o porquê. O motivo real fica no
# console.error da server action, ou seja, nos logs da Vercel.
#
# Sem domínio verificado, use o remetente de teste abaixo — mas saiba que ele
# só entrega para o e-mail dono da conta Resend.
CONTACT_FROM_EMAIL="Portfolio <onboarding@resend.dev>"
